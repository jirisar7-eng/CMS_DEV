datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// CORE DOMAIN
// -----------------------------------------------------------------------------
enum ProjectStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

model Project {
  id        String        @id @default(uuid())
  key       String        @unique
  name      String
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  userRoles               UserRole[]
  userPermissionOverrides UserPermissionOverride[]
  mediaAssets             MediaAsset[]
  navigationSets          NavigationSet[]
  brands                  Brand[]
  pages                   Page[]
  contentReleases         ContentRelease[]
  seoSettings             ProjectSeoSettings?
  redirectRules           RedirectRule[]
  searchDocuments         SearchDocument[]
}

// -----------------------------------------------------------------------------
// IDENTITY & ACCESS (Auth & RBAC)
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String?
  passwordHash String
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED, DISABLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions             Session[]
  roles                UserRole[]
  overrides            UserPermissionOverride[]
  auditLogs            AuditLog[]
  createdPageRevisions PageRevision[]           @relation("PageRevisionCreatedBy")
  createdReleases      ContentRelease[]         @relation("ContentReleaseCreatedBy")
  createdRedirects     RedirectRule[]

  @@index([status])
  @@index([email])
}

model Session {
  id        String   @id // crypto random string
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g., "brand.edit", "admin.access"
  description String?
  createdAt   DateTime @default(now())

  roles     RolePermission[]
  overrides UserPermissionOverride[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  projectId String? // Optional scope. If null, applies to SYSTEM/Global.
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, projectId])
  @@index([userId])
  @@index([projectId])
}

model UserPermissionOverride {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  isGranted    Boolean // true = explicit ALLOW, false = explicit DENY
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, projectId])
  @@index([userId])
  @@index([projectId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  scopeType    String // e.g., "SYSTEM", "PROJECT"
  scopeId      String?
  resourceType String? // e.g., "USER", "BRAND"
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([scopeType, scopeId])
}

// -----------------------------------------------------------------------------
// MEDIA (Existing)
// -----------------------------------------------------------------------------

model MediaAsset {
  id              String                @id @default(uuid())
  storageKey      String                @unique
  filename        String
  mimeType        String
  mediaType       String
  sizeBytes       Int
  dimensions      Json?
  url             String
  status          String
  metadata        Json
  projectId       String
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now())
  usageCount      Int                   @default(0)
  security        Json
  versions        MediaAssetVersion[]
  usageReferences MediaUsageReference[]

  @@index([projectId])
  @@index([status])
}

model MediaAssetVersion {
  id               String   @id @default(uuid())
  assetId          String
  versionNumber    Int
  status           String
  mimeType         String
  sizeBytes        Int
  storageKey       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  security         Json
  originalFilename String?

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, versionNumber])
  @@index([assetId])
}

model MediaUsageReference {
  id        String   @id @default(uuid())
  assetId   String
  pageId    String
  pageTitle String
  pageSlug  String
  blockId   String?
  blockType String?
  field     String?
  usedAt    DateTime @default(now())

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId])
}

// -----------------------------------------------------------------------------
// BRAND STUDIO
// -----------------------------------------------------------------------------

model Brand {
  id              String   @id @default(uuid())
  scope           String // "SYSTEM" or "PROJECT"
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name            String
  key             String   @unique
  activeVersionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions      BrandVersion[]
  activeVersion BrandVersion?  @relation("BrandActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  @@index([scope, projectId])
}

model BrandVersion {
  id                   String    @id @default(uuid())
  brandId              String
  version              Int
  status               String // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  tokens               Json
  typography           Json
  assets               Json
  themeModes           Json
  createdById          String?
  createdAt            DateTime  @default(now())
  publishedAt          DateTime?
  derivedFromVersionId String?

  brand           Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  activeForBrands Brand[] @relation("BrandActiveVersion")

  @@unique([brandId, version])
  @@index([brandId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// CONTENT LIFECYCLE FOUNDATION
// -----------------------------------------------------------------------------

enum PageRevisionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

enum PageVisibility {
  PUBLIC
  UNLISTED
  PASSWORD_PROTECTED
  INTERNAL
}

enum ContentReleaseStatus {
  DRAFT
  PUBLISHED
  ROLLED_BACK
}

model Page {
  id                  String   @id @default(uuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  key                 String
  parentId            String?
  sortOrder           Int      @default(0)
  draftRevisionId     String?
  publishedRevisionId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  parent            Page?                @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          Page[]               @relation("PageHierarchy")
  revisions         PageRevision[]       @relation("PageToRevisions")
  draftRevision     PageRevision?        @relation("PageDraftRevision", fields: [draftRevisionId], references: [id], onDelete: SetNull)
  publishedRevision PageRevision?        @relation("PagePublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  releaseItems      ContentReleaseItem[]
  navigationItems   NavigationItem[]
  searchDocuments   SearchDocument[]

  @@unique([projectId, key])
  @@index([projectId])
  @@index([parentId])
  @@index([projectId, parentId, sortOrder])
}

// =============================================================================
// REVISION IMMUTABILITY CONTRACT:
// - DRAFT revision may later be updated only with optimistic lockVersion
// - IN_REVIEW is immutable snapshot
// - APPROVED is immutable snapshot
// - PUBLISHED is immutable forever
// - editing after submit creates a NEW DRAFT revision
// - rollback changes Page.publishedRevision pointer
// - rollback never mutates historical revision content
// =============================================================================
model PageRevision {
  id                    String             @id @default(uuid())
  pageId                String
  revisionNumber        Int
  status                PageRevisionStatus
  title                 String
  slug                  String
  locale                String
  description           String?
  visibility            PageVisibility
  content               Json
  seo                   Json
  navigation            Json
  schemaVersion         String
  lockVersion           Int                @default(1)
  createdById           String?
  createdAt             DateTime           @default(now())
  submittedAt           DateTime?
  approvedAt            DateTime?
  publishedAt           DateTime?
  derivedFromRevisionId String?

  page             Page           @relation("PageToRevisions", fields: [pageId], references: [id], onDelete: Cascade)
  createdBy        User?          @relation("PageRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  derivedFrom      PageRevision?  @relation("RevisionDerivation", fields: [derivedFromRevisionId], references: [id], onDelete: SetNull)
  derivedRevisions PageRevision[] @relation("RevisionDerivation")

  draftForPages     Page[]           @relation("PageDraftRevision")
  publishedForPages Page[]           @relation("PagePublishedRevision")
  searchDocuments   SearchDocument[]

  releaseItems         ContentReleaseItem[] @relation("ReleaseItemRevision")
  previousReleaseItems ContentReleaseItem[] @relation("ReleaseItemPreviousRevision")

  @@unique([pageId, revisionNumber])
  @@index([pageId])
  @@index([status])
  @@index([createdAt])
}

model ContentRelease {
  id           String               @id @default(uuid())
  projectId    String
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  status       ContentReleaseStatus
  createdById  String?
  createdAt    DateTime             @default(now())
  publishedAt  DateTime?
  rolledBackAt DateTime?

  createdBy User?                @relation("ContentReleaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     ContentReleaseItem[]

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

model ContentReleaseItem {
  releaseId          String
  pageId             String
  revisionId         String
  previousRevisionId String?

  release          ContentRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  page             Page           @relation(fields: [pageId], references: [id], onDelete: Restrict)
  revision         PageRevision   @relation("ReleaseItemRevision", fields: [revisionId], references: [id], onDelete: Restrict)
  previousRevision PageRevision?  @relation("ReleaseItemPreviousRevision", fields: [previousRevisionId], references: [id], onDelete: Restrict)

  @@id([releaseId, pageId])
  @@index([pageId])
  @@index([revisionId])
  @@index([previousRevisionId])
}

enum NavigationContext {
  HEADER
  FOOTER
  MOBILE
  PORTAL
  CUSTOM
}

enum NavigationItemType {
  PAGE
  EXTERNAL_LINK
  ANCHOR
  GROUP
}

enum NavigationSetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model NavigationSet {
  id          String              @id @default(uuid())
  projectId   String
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  key         String
  name        String
  context     NavigationContext
  status      NavigationSetStatus @default(DRAFT)
  version     Int                 @default(1)
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items NavigationItem[]

  @@unique([projectId, key])
  @@index([projectId])
}

model NavigationItem {
  id       String           @id @default(uuid())
  setId    String
  set      NavigationSet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  parentId String?
  parent   NavigationItem?  @relation("ItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children NavigationItem[] @relation("ItemHierarchy")

  type         NavigationItemType
  label        String
  pageId       String?
  page         Page?              @relation(fields: [pageId], references: [id], onDelete: Restrict)
  externalUrl  String?
  anchor       String?
  icon         String?
  visibility   Boolean            @default(true)
  openInNewTab Boolean            @default(false)
  order        Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([setId])
  @@index([parentId])
  @@index([pageId])
}

// -----------------------------------------------------------------------------
// WEB STRUCTURE (SEO & REDIRECTS)
// -----------------------------------------------------------------------------

model ProjectSeoSettings {
  id                 String   @id @default(uuid())
  projectId          String   @unique
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  defaultTitle       String?
  titleTemplate      String?
  defaultDescription String?
  defaultOgImage     String?
  robotsTxt          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([projectId])
}

enum RedirectType {
  MOVED_PERMANENTLY // 301
  FOUND // 302
}

model RedirectRule {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourcePath  String
  targetPath  String
  type        RedirectType @default(MOVED_PERMANENTLY)
  active      Boolean      @default(true)
  priority    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, sourcePath])
  @@index([projectId, active])
}

// -----------------------------------------------------------------------------
// SEARCH — DERIVED / REBUILDABLE INDEX
// -----------------------------------------------------------------------------

model SearchDocument {
  id           String       @id @default(uuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageId       String
  page         Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  revisionId   String
  revision     PageRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  path         String
  title        String
  description  String?
  locale       String
  bodyText     String
  indexVersion Int          @default(1)
  indexedAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([projectId, pageId])
  @@unique([projectId, path])
  @@index([projectId, locale])
  @@index([revisionId])
}
