datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// IDENTITY & ACCESS (Auth & RBAC)
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String?
  passwordHash String
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED, DISABLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions  Session[]
  roles     UserRole[]
  overrides UserPermissionOverride[]
  auditLogs AuditLog[]

  @@index([status])
  @@index([email])
}

model Session {
  id        String   @id // crypto random string
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g., "brand.edit", "admin.access"
  description String?
  createdAt   DateTime @default(now())

  roles     RolePermission[]
  overrides UserPermissionOverride[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  projectId String? // Optional scope. If null, applies to SYSTEM/Global.
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, projectId])
  @@index([userId])
  @@index([projectId])
}

model UserPermissionOverride {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  projectId    String?
  isGranted    Boolean // true = explicit ALLOW, false = explicit DENY
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, projectId])
  @@index([userId])
  @@index([projectId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  scopeType    String // e.g., "SYSTEM", "PROJECT"
  scopeId      String?
  resourceType String? // e.g., "USER", "BRAND"
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([scopeType, scopeId])
}

// -----------------------------------------------------------------------------
// MEDIA (Existing)
// -----------------------------------------------------------------------------

model MediaAsset {
  id              String                @id @default(uuid())
  storageKey      String                @unique
  filename        String
  mimeType        String
  mediaType       String
  sizeBytes       Int
  dimensions      Json?
  url             String
  status          String
  metadata        Json
  projectId       String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now())
  usageCount      Int                   @default(0)
  security        Json
  versions        MediaAssetVersion[]
  usageReferences MediaUsageReference[]

  @@index([projectId])
  @@index([status])
}

model MediaAssetVersion {
  id               String     @id @default(uuid())
  assetId          String
  versionNumber    Int
  status           String
  mimeType         String
  sizeBytes        Int
  storageKey       String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now())
  security         Json
  originalFilename String?
  asset            MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, versionNumber])
  @@index([assetId])
}

model MediaUsageReference {
  id        String     @id @default(uuid())
  assetId   String
  pageId    String
  pageTitle String
  pageSlug  String
  blockId   String?
  blockType String?
  field     String?
  usedAt    DateTime   @default(now())
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId])
}

// -----------------------------------------------------------------------------
// BRAND STUDIO
// -----------------------------------------------------------------------------
model Brand {
  id              String   @id @default(uuid())
  scope           String // "SYSTEM" or "PROJECT"
  projectId       String?
  name            String
  key             String   @unique
  activeVersionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions      BrandVersion[]
  activeVersion BrandVersion?  @relation("BrandActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  @@index([scope, projectId])
}

model BrandVersion {
  id                   String    @id @default(uuid())
  brandId              String
  version              Int
  status               String // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  tokens               Json
  typography           Json
  assets               Json
  themeModes           Json
  createdById          String?
  createdAt            DateTime  @default(now())
  publishedAt          DateTime?
  derivedFromVersionId String?

  brand           Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  activeForBrands Brand[] @relation("BrandActiveVersion")

  @@unique([brandId, version])
  @@index([brandId])
  @@index([status])
}
